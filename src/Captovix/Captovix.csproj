<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Captovix</AssemblyName>
    <Product>Captovix</Product>
    <ApplicationIcon>Assets/Captovix.ico</ApplicationIcon>
    <Version>1.15.0</Version>
    <StartupObject>Captovix.Program</StartupObject>
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
    <PublishTrimmed>false</PublishTrimmed>
    <Company>HuyVo</Company>
    <Copyright>© 2026 HuyVo. All rights reserved.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Captovix.ico" />
    <Resource Include="Assets/Captovix-mark.png" />
    <Resource Include="Assets/Captovix-mark-light.png" />
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <None Update="update-source.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
