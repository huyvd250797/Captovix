<Window x:Class="Captovix.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Captovix" Title="Captovix · V1.6.1 — Image Fidelity" Width="1440" Height="900" MinWidth="900" MinHeight="480" WindowStartupLocation="CenterScreen" WindowState="Maximized" UseLayoutRounding="True" Icon="Assets/Captovix.ico" PreviewKeyDown="Editor_KeyDown" PreviewKeyUp="Editor_KeyUp">
 <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,10">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Mở file" Click="Import_Click"/><Button x:Name="UndoButton" Content="↶" ToolTip="Hoàn tác · Ctrl+Z" Click="Undo_Click" IsEnabled="False"/><Button x:Name="RedoButton" Content="↷" ToolTip="Làm lại · Ctrl+Y" Click="Redo_Click" IsEnabled="False"/><Button x:Name="CopyButton" Content="Copy ảnh" Click="Copy_Click" IsEnabled="False"/><Button x:Name="ExportButton" Content="Xuất file" Style="{StaticResource Primary}" Click="Export_Click" IsEnabled="False"/></StackPanel>
   <StackPanel Orientation="Horizontal"><Border Background="#DDF2F2" CornerRadius="9" Padding="13,7" Margin="0,0,14,0"><StackPanel><TextBlock Text="CAPTOVIX" FontSize="18" FontWeight="Bold" Foreground="#00777F"/><TextBlock Text="V1.6.1 · Image Fidelity" FontSize="10" Foreground="#667788"/></StackPanel></Border><Button x:Name="CaptureButton" Content="▣  Chụp ảnh" Style="{StaticResource Primary}" Click="Capture_Click" ToolTip="Ctrl + Shift + 1"/><Button x:Name="RecordButton" Content="●  Quay màn hình" Click="Record_Click" ToolTip="Ctrl + Shift + 2"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,10" Padding="12,7">
   <Expander Header="Thiết lập chụp, preset &amp; phím tắt" IsExpanded="False"><ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,7,0,0"><WrapPanel x:Name="ConfigPanel">
    <ComboBox x:Name="SourceMode" Width="135" SelectedIndex="0" SelectionChanged="SourceMode_Changed"><ComboBoxItem Content="Vùng chọn"/><ComboBoxItem Content="Cửa sổ"/><ComboBoxItem Content="Toàn màn hình"/></ComboBox>
    <ComboBox x:Name="DisplayPicker" Width="255" DisplayMemberPath="Label" ToolTip="Màn hình dùng cho chế độ Toàn màn hình"/><ComboBox x:Name="WindowPicker" Width="255" DisplayMemberPath="Title" Visibility="Collapsed"/>
    <Button Content="↻" ToolTip="Làm mới nguồn" Click="Refresh_Click" Padding="10,5"/>
    <TextBlock Text="Trễ" VerticalAlignment="Center" Margin="8,0,0,0"/><ComboBox x:Name="DelayPicker" Width="70" SelectedIndex="0"><ComboBoxItem Content="0 giây" Tag="0"/><ComboBoxItem Content="3 giây" Tag="3"/><ComboBoxItem Content="5 giây" Tag="5"/></ComboBox>
    <CheckBox x:Name="CursorToggle" Content="Con trỏ" IsChecked="True"/><CheckBox x:Name="MicToggle" Content="Mic"/><CheckBox x:Name="SystemToggle" Content="Tiếng máy" IsChecked="True"/>
    <ComboBox x:Name="FpsPicker" Width="85" SelectedIndex="1"><ComboBoxItem Content="15 FPS" Tag="15"/><ComboBoxItem Content="30 FPS" Tag="30"/><ComboBoxItem Content="60 FPS" Tag="60"/></ComboBox><CheckBox x:Name="HardwareToggle" Content="Mã hóa GPU" IsChecked="True"/>
   </WrapPanel>
    <WrapPanel Margin="0,7"><Button Content="Chụp lại vùng" Click="RepeatCapture_Click"/><Button x:Name="CancelCaptureButton" Content="Hủy / Dừng phiên" Click="CancelCapture_Click" IsEnabled="False"/></WrapPanel>
    <StackPanel x:Name="WorkflowPanel">
     <WrapPanel><TextBlock Text="Sau khi chụp ảnh" VerticalAlignment="Center" Margin="5"/><ComboBox x:Name="AfterPhotoPicker" Width="185" SelectedIndex="0"><ComboBoxItem Content="Mở trong Editor"/><ComboBoxItem Content="Lưu nền + thông báo"/></ComboBox><CheckBox x:Name="AutoCopyPhoto" Content="Tự copy ảnh"/></WrapPanel>
     <WrapPanel Margin="0,7"><TextBlock Text="Preset chụp" VerticalAlignment="Center" Margin="5"/><ComboBox x:Name="CapturePresetPicker" Width="165" DisplayMemberPath="Name"/><Button Content="Áp dụng" Click="ApplyCapturePreset_Click"/><Button Content="Xóa preset" Click="DeleteCapturePreset_Click"/><TextBox x:Name="CapturePresetName" Width="165" MaxLength="40" ToolTip="Tên preset mới"/><Button Content="Lưu preset mới" Click="SaveCapturePreset_Click"/></WrapPanel>
     <Expander Header="Phím tắt &amp; chạy nền"><StackPanel Margin="8"><StackPanel x:Name="HotkeyRows"/><TextBlock Text="Quay: Ctrl+Shift+2 · Dừng: Ctrl+Shift+3 · Tạm dừng: Ctrl+Shift+4" Foreground="#68798A" Margin="5,8"/>
      <WrapPanel><CheckBox x:Name="CloseToTrayToggle" Content="Đóng xuống khay"/><CheckBox x:Name="StartWindowsToggle" Content="Khởi động cùng Windows"/><CheckBox x:Name="StartTrayToggle" Content="Ẩn vào khay khi Windows khởi động"/></WrapPanel>
      <TextBlock Text="Mở app thủ công luôn hiển thị Editor. Khởi động cùng Windows không tự chụp." Foreground="#68798A" Margin="5"/>
     </StackPanel></Expander>
     <WrapPanel><Button Content="Lưu cấu hình Workflow" Click="SaveWorkflow_Click"/><Button Content="Khôi phục mặc định" Click="ResetWorkflow_Click"/></WrapPanel>
     <TextBlock x:Name="WorkflowStatus" Text="Tùy chọn chạy nền và khởi động Windows mặc định tắt." TextWrapping="Wrap" Margin="5" Foreground="#00777F"/>
    </StackPanel><TextBlock Text="PNG theo pixel gốc · MP4/H.264 theo kích thước nguồn · Mic/tiếng máy dùng thiết bị mặc định Windows" FontSize="11" Foreground="#738092" Margin="5,7,0,2"/></StackPanel></ScrollViewer></Expander>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="220" MinWidth="180"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Padding="10"><DockPanel>
    <StackPanel DockPanel.Dock="Top"><DockPanel Margin="4,0,4,8"><TextBlock Text="Nội dung" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="CountLabel" HorizontalAlignment="Right" Foreground="#738092"/></DockPanel><TextBox x:Name="SearchBox" ToolTip="Tìm tên, ngày hoặc ảnh/video" TextChanged="Search_Changed"/><TextBlock Text="Ảnh và video của bạn" FontSize="11" Foreground="#7D8998" Margin="5,0,0,8"/></StackPanel>
    <Button DockPanel.Dock="Bottom" Content="Mở thư mục nội dung" Click="Folder_Click"/>
    <ListBox x:Name="MediaList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Media_Changed" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" CornerRadius="7" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="#E5EAEE" Background="White"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#E7F5F5"/><Setter TargetName="Card" Property="BorderBrush" Value="#008B92"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel><Border Height="94" Background="#EEF2F5" CornerRadius="4"><Grid><TextBlock Text="{Binding Badge}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#647688" FontWeight="SemiBold"/><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Grid></Border><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,7,0,3"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#738092"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="16,12"><TextBlock x:Name="DocumentTitle" Text="Không gian làm việc" FontWeight="SemiBold" FontSize="17" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SavedLabel" Foreground="#23946E" HorizontalAlignment="Right"/></DockPanel>
    <StackPanel x:Name="ImageTools" Grid.Row="1" Visibility="Collapsed" Margin="9,0,9,8"><WrapPanel x:Name="ToolBox">
     <Button Content="↖ Chọn" Tag="Select" Click="Tool_Click" ToolTip="V · Chọn, kéo đối tượng; kéo tay nắm để đổi kích thước" Padding="9,7"/>
     <Button Content="↗ Mũi tên" Tag="Arrow" Click="Tool_Click" ToolTip="A" Padding="9,7"/>
     <Button Content="▭ Khung" Tag="Rectangle" Click="Tool_Click" ToolTip="R" Padding="9,7"/>
     <Button Content="◯ Ellipse" Tag="Ellipse" Click="Tool_Click" ToolTip="E" Padding="9,7"/>
     <Button Content="T Chữ" Tag="Text" Click="Tool_Click" ToolTip="T · Click lên ảnh rồi nhập ở bảng thuộc tính" Padding="9,7"/>
     <Button Content="▰ Highlight" Tag="Highlight" Click="Tool_Click" ToolTip="H" Padding="9,7"/>
     <Button Content="① Bước" Tag="Step" Click="Tool_Click" ToolTip="N · Đánh số tự tăng" Padding="9,7"/>
     <Button Content="░ Làm mờ" Tag="Blur" Click="Tool_Click" ToolTip="B · Làm mờ vùng ảnh" Padding="9,7"/>
     <Button Content="▦ Pixel" Tag="Pixelate" Click="Tool_Click" ToolTip="P · Pixel hóa vùng ảnh" Padding="9,7"/>
     <Button Content="■ Che kín" Tag="Cover" Click="Tool_Click" ToolTip="K · Che bằng màu đặc" Padding="9,7"/>
     <Button Content="▱ Callout" Tag="Callout" Click="Tool_Click" ToolTip="Q · Kéo hộp chú thích; sửa chữ tại ảnh; kéo tay nắm đuôi để đổi điểm chỉ" Padding="9,7"/>
     <Button Content="〰 Vẽ tự do" Tag="Freehand" Click="Tool_Click" ToolTip="F · Giữ chuột trái để vẽ nét" Padding="9,7"/>
     <Button Content="⌗ Crop" Tag="Crop" Click="Tool_Click" ToolTip="C · Kéo vùng, chỉnh tay nắm/kích thước rồi Áp dụng" Padding="9,7"/>
    </WrapPanel><TextBlock x:Name="ToolHint" TextWrapping="Wrap" LineHeight="17" Text="Chọn công cụ để bắt đầu chú thích ảnh." FontSize="11" Foreground="#738092" Margin="5,4,0,0"/></StackPanel>
    <Grid Grid.Row="2" Background="#E9EDF1" Margin="8,0"><ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" SizeChanged="Viewport_Changed"><Border Background="{StaticResource TransparencyGrid}" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid ClipToBounds="True"><local:EditorSurface x:Name="Surface"/><Canvas x:Name="InlineCanvas"><TextBox x:Name="InlineText" Visibility="Collapsed" MaxLength="20000" AcceptsReturn="True" Padding="0" Margin="0" BorderThickness="1" BorderBrush="#008B92" Background="White" FontFamily="Segoe UI" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewKeyDown="InlineText_KeyDown" LostKeyboardFocus="InlineText_LostFocus" ToolTip="Ctrl+Enter hoàn tất · Esc hủy · Enter xuống dòng"/></Canvas></Grid></Border></ScrollViewer>
     <MediaElement x:Name="VideoPreview" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Visibility="Collapsed" MediaOpened="Video_Opened" MediaEnded="Video_Ended" MediaFailed="Video_Failed"/>
     <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"><TextBlock Text="▣" FontSize="60" Foreground="#008B92" HorizontalAlignment="Center"/><TextBlock Text="Chụp. Chú thích. Chia sẻ." FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,10"/><TextBlock Text="Chụp ảnh mới hoặc mở ảnh có sẵn. Thêm mũi tên, chữ, đánh số bước và crop ngay trong Editor này." TextWrapping="Wrap" TextAlignment="Center" Foreground="#68798A" LineHeight="22"/><TextBlock Text="Ctrl + Shift + 1 · Chụp ảnh&#10;Ctrl + Shift + 2 · Quay màn hình" TextAlignment="Center" Foreground="#008B92" Margin="0,22,0,0" LineHeight="23"/></StackPanel>
    </Grid>
    <StackPanel Grid.Row="3" Margin="10,8"><WrapPanel x:Name="ZoomTools" Visibility="Collapsed"><StackPanel Margin="7,0"><TextBlock x:Name="OriginalSizeLabel" FontSize="11" Foreground="#68798A"/><StackPanel Orientation="Horizontal"><TextBlock Text="Xuất / Copy: " Foreground="#00777F"/><TextBlock x:Name="ImageSizeLabel" Foreground="#00777F"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Vừa khung" Click="Fit_Click" Padding="9,6"/><Button Content="Actual Pixels" ToolTip="1 pixel đầu ra = 1 pixel màn hình; không đổi kích thước file" Click="Actual_Click" Padding="9,6"/><Button Content="−" Click="ZoomOut_Click" Padding="10,6"/><TextBlock Text="Zoom " VerticalAlignment="Center"/><TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center" Margin="5,0"/><Button Content="+" Click="ZoomIn_Click" Padding="10,6"/></StackPanel><TextBlock x:Name="ImageFidelityHint" FontSize="11" Foreground="#68798A" MaxWidth="600" TextWrapping="Wrap" Margin="7,4"/></WrapPanel>
     <StackPanel x:Name="VideoTools" Visibility="Collapsed"><Slider x:Name="VideoSeek" Minimum="0" PreviewMouseLeftButtonUp="Seek_Released"/><StackPanel Orientation="Horizontal"><Button Content="▶ Phát" Click="Play_Click"/><Button Content="Ⅱ Tạm dừng" Click="Pause_Click"/><TextBlock x:Name="VideoTime" VerticalAlignment="Center" Margin="10,0"/></StackPanel></StackPanel>
    </StackPanel>
   </Grid></Border>
   <Border Grid.Column="4" Style="{StaticResource Panel}" Padding="13"><DockPanel>
    <StackPanel DockPanel.Dock="Bottom"><Separator Margin="0,10"/><TextBlock Text="CAPTOVIX · 1.6.1" FontSize="10" Foreground="#8090A0"/><TextBlock Text="Unified Editor · Lưu trên máy" FontSize="11" Foreground="#8090A0" Margin="0,5"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <StackPanel x:Name="EditorProperties" Visibility="Collapsed">
      <Expander Header="Ảnh &amp; khung · V1.4" Margin="0,0,0,12"><StackPanel x:Name="ImageStylePanel">
       <TextBlock x:Name="OutputSummary" TextWrapping="Wrap" Foreground="#008B92" FontSize="11" Margin="3,7"/>
       <UniformGrid Columns="2"><Button Content="↶ Xoay trái" Tag="Left" Click="AppearanceAction_Click" Padding="6,7"/><Button Content="↷ Xoay phải" Tag="Right" Click="AppearanceAction_Click" Padding="6,7"/><Button Content="Lật ngang" Tag="FlipH" Click="AppearanceAction_Click" Padding="6,7"/><Button Content="Lật dọc" Tag="FlipV" Click="AppearanceAction_Click" Padding="6,7"/></UniformGrid>
       <Expander Header="Kích thước ảnh" IsExpanded="True"><StackPanel><UniformGrid Columns="2"><StackPanel><TextBlock Text="Rộng · px"/><TextBox x:Name="ResizeW" ToolTip="Chiều rộng ảnh" TextChanged="ResizeInput_Changed"/></StackPanel><StackPanel><TextBlock Text="Cao · px"/><TextBox x:Name="ResizeH" ToolTip="Chiều cao ảnh" TextChanged="ResizeInput_Changed"/></StackPanel></UniformGrid><CheckBox x:Name="KeepRatio" Content="Giữ tỷ lệ" IsChecked="True" Margin="3,5"/><UniformGrid Columns="2"><Button Content="Áp dụng cỡ" Click="ApplyResize_Click" Padding="6,7"/><Button Content="Cỡ gốc" Tag="Natural" Click="AppearanceAction_Click" Padding="6,7"/></UniformGrid></StackPanel></Expander>
       <Expander Header="Canvas &amp; vị trí" Margin="0,7"><StackPanel><CheckBox x:Name="CustomCanvas" Content="Dùng canvas riêng" Margin="3,5"/><UniformGrid Columns="2"><StackPanel><TextBlock Text="Rộng canvas"/><TextBox x:Name="CanvasW" ToolTip="Chiều rộng canvas"/></StackPanel><StackPanel><TextBlock Text="Cao canvas"/><TextBox x:Name="CanvasH" ToolTip="Chiều cao canvas"/></StackPanel></UniformGrid><ComboBox x:Name="CanvasAnchor" SelectedIndex="4"><ComboBoxItem Content="Trên trái"/><ComboBoxItem Content="Trên giữa"/><ComboBoxItem Content="Trên phải"/><ComboBoxItem Content="Giữa trái"/><ComboBoxItem Content="Chính giữa"/><ComboBoxItem Content="Giữa phải"/><ComboBoxItem Content="Dưới trái"/><ComboBoxItem Content="Dưới giữa"/><ComboBoxItem Content="Dưới phải"/></ComboBox><TextBlock Text="Canvas nhỏ hơn ảnh sẽ cắt phần vượt khung. Ảnh gốc vẫn giữ nguyên." TextWrapping="Wrap" FontSize="10" Foreground="#738092" Margin="3,5"/><Button Content="Áp dụng canvas" Click="ApplyCanvas_Click"/></StackPanel></Expander>
       <Expander Header="Viền · nền · bóng đổ"><StackPanel><UniformGrid Columns="3"><Button Content="Bỏ kiểu" Tag="Clear" Click="FramePreset_Click" Padding="4,7"/><Button Content="Sáng" Tag="Light" Click="FramePreset_Click" Padding="4,7"/><Button Content="Tối" Tag="Dark" Click="FramePreset_Click" Padding="4,7"/></UniformGrid><UniformGrid Columns="2"><StackPanel><TextBlock Text="Khoảng đệm · px"/><TextBox x:Name="FramePadding" ToolTip="Khoảng đệm"/></StackPanel><StackPanel><TextBlock Text="Viền · px"/><TextBox x:Name="FrameBorder" ToolTip="Độ dày viền"/></StackPanel></UniformGrid><TextBlock Text="Màu viền · #RRGGBB"/><TextBox x:Name="FrameBorderColor"/><CheckBox x:Name="TransparentBackground" Content="Nền trong suốt (PNG)" IsChecked="True" Margin="3,6"/><TextBlock Text="Màu nền · #RRGGBB"/><TextBox x:Name="FrameBackground"/><CheckBox x:Name="ShadowEnabled" Content="Bóng đổ khung" Margin="3,6"/><UniformGrid Columns="2"><StackPanel><TextBlock Text="Độ mềm · px"/><TextBox x:Name="ShadowBlur" ToolTip="Độ mềm bóng"/></StackPanel><StackPanel><TextBlock Text="Độ đậm · %"/><TextBox x:Name="ShadowOpacity" ToolTip="Độ đậm bóng"/></StackPanel><StackPanel><TextBlock Text="Lệch X · px"/><TextBox x:Name="ShadowX" ToolTip="Độ lệch bóng X"/></StackPanel><StackPanel><TextBlock Text="Lệch Y · px"/><TextBox x:Name="ShadowY" ToolTip="Độ lệch bóng Y"/></StackPanel></UniformGrid><Button Content="Áp dụng kiểu khung" Click="ApplyFrame_Click"/></StackPanel></Expander>
       <Button Content="Đặt lại trình bày ảnh" Tag="ResetAll" Click="AppearanceAction_Click"/><TextBlock Text="Chú thích đi theo ảnh khi xoay/lật/resize. Kích thước đầu ra tính cả viền, đệm và bóng." TextWrapping="Wrap" FontSize="10" Foreground="#738092" Margin="3,5"/>
      </StackPanel></Expander>
      <StackPanel x:Name="CropProperties" Visibility="Collapsed"><TextBlock Text="Crop chính xác" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="CropHint" TextWrapping="Wrap" FontSize="11" Foreground="#738092" Margin="3,7"/>
       <UniformGrid Columns="2"><StackPanel><TextBlock Text="X · ảnh gốc"/><TextBox x:Name="CropX" PreviewKeyDown="CropField_KeyDown"/></StackPanel><StackPanel><TextBlock Text="Y · ảnh gốc"/><TextBox x:Name="CropY" PreviewKeyDown="CropField_KeyDown"/></StackPanel><StackPanel><TextBlock Text="Rộng (px)"/><TextBox x:Name="CropWidth" PreviewKeyDown="CropField_KeyDown"/></StackPanel><StackPanel><TextBlock Text="Cao (px)"/><TextBox x:Name="CropHeight" PreviewKeyDown="CropField_KeyDown"/></StackPanel></UniformGrid>
       <Button Content="Xem vùng" Click="PreviewCrop_Click"/><Button Content="Áp dụng crop · Enter" Style="{StaticResource Primary}" Click="ApplyCrop_Click"/><WrapPanel><Button Content="Chọn lại" Click="RestartCrop_Click" Padding="10,7"/><Button Content="Hủy · Esc" Click="CancelCrop_Click" Padding="10,7"/></WrapPanel><Separator Margin="0,10"/>
      </StackPanel><TextBlock x:Name="PropertyTitle" Text="Thuộc tính chú thích" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap"/>
      <Expander Header="Preset màu · nét · chữ" IsExpanded="True" Margin="0,10,0,3"><StackPanel>
       <ComboBox x:Name="PresetPicker" DisplayMemberPath="Name" ToolTip="Chọn mẫu rồi bấm Áp dụng"/>
