      <Button x:Name="OpenReleaseButton" Content="Mở trang tải bản mới" Click="OpenRelease_Click" Visibility="Collapsed"/>
      <TextBlock x:Name="LastUpdateCheckLabel" Foreground="#738092" FontSize="10" TextWrapping="Wrap" Margin="0,7"/>
      <Expander x:Name="UpdateConfiguration" Header="Cấu hình nguồn cập nhật" FontSize="12" Margin="0,6"><StackPanel Margin="0,7,0,0">
       <TextBlock Text="Chỉ dùng nguồn phát hành do Boss tin cậy." TextWrapping="Wrap" FontSize="11" Foreground="#738092"/>
       <ComboBox x:Name="SourceKindPicker" SelectedIndex="0"><ComboBoxItem Content="GitHub Releases (công khai)"/><ComboBoxItem Content="Thư mục HTTPS"/></ComboBox>
       <TextBox x:Name="UpdateSourceBox" TextWrapping="Wrap" MinHeight="56" MaxHeight="110" VerticalScrollBarVisibility="Auto" ToolTip="GitHub: https://github.com/OWNER/REPO; HTTPS: URL thư mục chứa releases.win.json"/>
       <CheckBox x:Name="AutoUpdateCheck" Content="Tự kiểm tra mỗi ngày" IsChecked="True" Margin="3,7"/>
       <Button Content="Lưu cấu hình" Click="SaveUpdateSource_Click"/>
       <TextBlock Text="GitHub: https://github.com/OWNER/REPO. HTTPS: thư mục chứa gói cập nhật. Không nhập token hoặc mật khẩu." TextWrapping="Wrap" Foreground="#738092" FontSize="10" LineHeight="17" Margin="3,5"/>
      </StackPanel></Expander>
     </StackPanel></Expander>
     <Separator Margin="0,12"/><Expander Header="Máy và màn hình"><StackPanel><TextBlock x:Name="DisplaySummary" Margin="0,8" TextWrapping="Wrap" FontSize="11" Foreground="#68798A" LineHeight="20"/><Button Content="Báo cáo máy &amp; màn hình" Click="Diagnostics_Click"/><Button Content="Kiểm chứng ảnh SDR trên máy này" Click="FidelityCheck_Click"/><Button Content="Hướng dẫn kiểm thử" Click="TestGuide_Click"/></StackPanel></Expander>
    </StackPanel></ScrollViewer>
   </DockPanel></Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="3,10,3,0"><TextBlock Text="© 2026 HuyVo" DockPanel.Dock="Right" Foreground="#8A97A5" FontSize="11"/><Button x:Name="UpdateFooterButton" Content="↻ Cập nhật" DockPanel.Dock="Right" Click="UpdateFooter_Click" Padding="10,3" Margin="12,0"/><TextBlock x:Name="StatusText" Text="● Sẵn sàng" Foreground="#66798B" TextTrimming="CharacterEllipsis"/></DockPanel>
 </Grid>
