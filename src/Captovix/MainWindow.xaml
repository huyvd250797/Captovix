<Window x:Class="Captovix.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Captovix" Title="Captovix · V1.1.0 — Image Annotation" Width="1440" Height="900" MinWidth="900" MinHeight="480" WindowStartupLocation="CenterScreen" WindowState="Maximized" Icon="Assets/Captovix.ico" PreviewKeyDown="Editor_KeyDown">
 <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,10">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Mở file" Click="Import_Click"/><Button x:Name="UndoButton" Content="↶" ToolTip="Hoàn tác · Ctrl+Z" Click="Undo_Click" IsEnabled="False"/><Button x:Name="RedoButton" Content="↷" ToolTip="Làm lại · Ctrl+Y" Click="Redo_Click" IsEnabled="False"/><Button x:Name="CopyButton" Content="Copy ảnh" Click="Copy_Click" IsEnabled="False"/><Button x:Name="ExportButton" Content="Xuất file" Style="{StaticResource Primary}" Click="Export_Click" IsEnabled="False"/></StackPanel>
   <StackPanel Orientation="Horizontal"><Border Background="#DDF2F2" CornerRadius="9" Padding="13,7" Margin="0,0,14,0"><StackPanel><TextBlock Text="CAPTOVIX" FontSize="18" FontWeight="Bold" Foreground="#00777F"/><TextBlock Text="V1.1.0 · Image Annotation" FontSize="10" Foreground="#667788"/></StackPanel></Border><Button x:Name="CaptureButton" Content="▣  Chụp ảnh" Style="{StaticResource Primary}" Click="Capture_Click" ToolTip="Ctrl + Shift + 1"/><Button x:Name="RecordButton" Content="●  Quay màn hình" Click="Record_Click" ToolTip="Ctrl + Shift + 2"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,10" Padding="12,7">
   <Expander Header="Thiết lập chụp &amp; quay" IsExpanded="False"><StackPanel Margin="0,7,0,0"><WrapPanel x:Name="ConfigPanel">
    <ComboBox x:Name="SourceMode" Width="135" SelectedIndex="0" SelectionChanged="SourceMode_Changed"><ComboBoxItem Content="Vùng chọn"/><ComboBoxItem Content="Cửa sổ"/><ComboBoxItem Content="Toàn màn hình"/></ComboBox>
    <ComboBox x:Name="DisplayPicker" Width="255" DisplayMemberPath="Label" ToolTip="Màn hình dùng cho chế độ Toàn màn hình"/><ComboBox x:Name="WindowPicker" Width="255" DisplayMemberPath="Title" Visibility="Collapsed"/>
    <Button Content="↻" ToolTip="Làm mới nguồn" Click="Refresh_Click" Padding="10,5"/>
    <TextBlock Text="Trễ" VerticalAlignment="Center" Margin="8,0,0,0"/><ComboBox x:Name="DelayPicker" Width="70" SelectedIndex="0"><ComboBoxItem Content="0 giây" Tag="0"/><ComboBoxItem Content="3 giây" Tag="3"/><ComboBoxItem Content="5 giây" Tag="5"/></ComboBox>
    <CheckBox x:Name="CursorToggle" Content="Con trỏ" IsChecked="True"/><CheckBox x:Name="MicToggle" Content="Mic"/><CheckBox x:Name="SystemToggle" Content="Tiếng máy" IsChecked="True"/>
    <ComboBox x:Name="FpsPicker" Width="85" SelectedIndex="1"><ComboBoxItem Content="15 FPS" Tag="15"/><ComboBoxItem Content="30 FPS" Tag="30"/><ComboBoxItem Content="60 FPS" Tag="60"/></ComboBox><CheckBox x:Name="HardwareToggle" Content="Mã hóa GPU" IsChecked="True"/>
   </WrapPanel><TextBlock Text="PNG theo pixel gốc · MP4/H.264 theo kích thước nguồn · Mic/tiếng máy dùng thiết bị mặc định Windows" FontSize="11" Foreground="#738092" Margin="5,7,0,2"/></StackPanel></Expander>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="220" MinWidth="180"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Padding="10"><DockPanel>
    <StackPanel DockPanel.Dock="Top"><DockPanel Margin="4,0,4,8"><TextBlock Text="Nội dung" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="CountLabel" HorizontalAlignment="Right" Foreground="#738092"/></DockPanel><TextBox x:Name="SearchBox" ToolTip="Tìm tên, ngày hoặc ảnh/video" TextChanged="Search_Changed"/><TextBlock Text="Ảnh và video của bạn" FontSize="11" Foreground="#7D8998" Margin="5,0,0,8"/></StackPanel>
    <Button DockPanel.Dock="Bottom" Content="Mở thư mục nội dung" Click="Folder_Click"/>
    <ListBox x:Name="MediaList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Media_Changed" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" CornerRadius="7" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="#E5EAEE" Background="White"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#E7F5F5"/><Setter TargetName="Card" Property="BorderBrush" Value="#008B92"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel><Border Height="94" Background="#EEF2F5" CornerRadius="4"><Grid><TextBlock Text="{Binding Badge}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#647688" FontWeight="SemiBold"/><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Grid></Border><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,7,0,3"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#738092"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="16,12"><TextBlock x:Name="DocumentTitle" Text="Không gian làm việc" FontWeight="SemiBold" FontSize="17" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SavedLabel" Foreground="#23946E" HorizontalAlignment="Right"/></DockPanel>
    <StackPanel x:Name="ImageTools" Grid.Row="1" Visibility="Collapsed" Margin="9,0,9,8"><WrapPanel x:Name="ToolBox">
     <Button Content="↖ Chọn" Tag="Select" Click="Tool_Click" ToolTip="V · Chọn, kéo đối tượng; kéo tay nắm để đổi kích thước" Padding="9,7"/>
     <Button Content="↗ Mũi tên" Tag="Arrow" Click="Tool_Click" ToolTip="A" Padding="9,7"/>
     <Button Content="▭ Khung" Tag="Rectangle" Click="Tool_Click" ToolTip="R" Padding="9,7"/>
     <Button Content="◯ Ellipse" Tag="Ellipse" Click="Tool_Click" ToolTip="E" Padding="9,7"/>
     <Button Content="T Chữ" Tag="Text" Click="Tool_Click" ToolTip="T · Click lên ảnh rồi nhập ở bảng thuộc tính" Padding="9,7"/>
     <Button Content="▰ Highlight" Tag="Highlight" Click="Tool_Click" ToolTip="H" Padding="9,7"/>
     <Button Content="① Bước" Tag="Step" Click="Tool_Click" ToolTip="N · Đánh số tự tăng" Padding="9,7"/>
     <Button Content="░ Làm mờ" Tag="Blur" Click="Tool_Click" ToolTip="B · Làm mờ vùng ảnh" Padding="9,7"/>
     <Button Content="▦ Pixel" Tag="Pixelate" Click="Tool_Click" ToolTip="P · Pixel hóa vùng ảnh" Padding="9,7"/>
     <Button Content="■ Che kín" Tag="Cover" Click="Tool_Click" ToolTip="K · Che bằng màu đặc" Padding="9,7"/>
     <Button Content="⌗ Crop" Tag="Crop" Click="Tool_Click" ToolTip="C · Kéo và thả vùng muốn giữ" Padding="9,7"/>
    </WrapPanel><TextBlock x:Name="ToolHint" TextWrapping="Wrap" LineHeight="17" Text="Chọn công cụ để bắt đầu chú thích ảnh." FontSize="11" Foreground="#738092" Margin="5,4,0,0"/></StackPanel>
    <Grid Grid.Row="2" Background="#E9EDF1" Margin="8,0"><ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" SizeChanged="Viewport_Changed"><Border Background="White" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"><local:EditorSurface x:Name="Surface"/></Border></ScrollViewer>
     <MediaElement x:Name="VideoPreview" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Visibility="Collapsed" MediaOpened="Video_Opened" MediaEnded="Video_Ended" MediaFailed="Video_Failed"/>
     <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"><TextBlock Text="▣" FontSize="60" Foreground="#008B92" HorizontalAlignment="Center"/><TextBlock Text="Chụp. Chú thích. Chia sẻ." FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,10"/><TextBlock Text="Chụp ảnh mới hoặc mở ảnh có sẵn. Thêm mũi tên, chữ, đánh số bước và crop ngay trong Editor này." TextWrapping="Wrap" TextAlignment="Center" Foreground="#68798A" LineHeight="22"/><TextBlock Text="Ctrl + Shift + 1 · Chụp ảnh&#10;Ctrl + Shift + 2 · Quay màn hình" TextAlignment="Center" Foreground="#008B92" Margin="0,22,0,0" LineHeight="23"/></StackPanel>
    </Grid>
    <StackPanel Grid.Row="3" Margin="10,8"><WrapPanel x:Name="ZoomTools" Visibility="Collapsed"><TextBlock x:Name="ImageSizeLabel" VerticalAlignment="Center" Foreground="#7C8797" Margin="7,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Vừa khung" Click="Fit_Click" Padding="9,6"/><Button Content="100%" Click="Actual_Click" Padding="9,6"/><Button Content="−" Click="ZoomOut_Click" Padding="10,6"/><TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center" Margin="5,0"/><Button Content="+" Click="ZoomIn_Click" Padding="10,6"/></StackPanel></WrapPanel>
     <StackPanel x:Name="VideoTools" Visibility="Collapsed"><Slider x:Name="VideoSeek" Minimum="0" PreviewMouseLeftButtonUp="Seek_Released"/><StackPanel Orientation="Horizontal"><Button Content="▶ Phát" Click="Play_Click"/><Button Content="Ⅱ Tạm dừng" Click="Pause_Click"/><TextBlock x:Name="VideoTime" VerticalAlignment="Center" Margin="10,0"/></StackPanel></StackPanel>
    </StackPanel>
   </Grid></Border>
   <Border Grid.Column="4" Style="{StaticResource Panel}" Padding="13"><DockPanel>
    <StackPanel DockPanel.Dock="Bottom"><Separator Margin="0,10"/><TextBlock Text="CAPTOVIX · 1.1.0" FontSize="10" Foreground="#8090A0"/><TextBlock Text="Unified Editor · Lưu trên máy" FontSize="11" Foreground="#8090A0" Margin="0,5"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <StackPanel x:Name="EditorProperties" Visibility="Collapsed"><TextBlock x:Name="PropertyTitle" Text="Thuộc tính chú thích" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap"/>
      <Expander Header="Preset màu · nét · chữ" IsExpanded="True" Margin="0,10,0,3"><StackPanel>
       <ComboBox x:Name="PresetPicker" DisplayMemberPath="Name" ToolTip="Chọn mẫu rồi bấm Áp dụng"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Áp dụng" Click="ApplyPreset_Click"/><Button x:Name="DeletePresetButton" Grid.Column="1" Content="Xóa mẫu" Click="DeletePreset_Click" ToolTip="Chỉ xóa preset riêng"/></Grid>
       <Expander Header="Lưu thành preset riêng" FontSize="11"><StackPanel><TextBlock Text="Tên preset" Margin="4,5,0,0"/><TextBox x:Name="PresetName" MaxLength="40" ToolTip="Tên mẫu, tối đa 40 ký tự"/><Button x:Name="SavePresetButton" Content="Lưu mẫu hiện tại" Click="SavePreset_Click"/></StackPanel></Expander>
      </StackPanel></Expander>
      <StackPanel x:Name="EffectProperties" Visibility="Collapsed" Margin="0,6"><TextBlock Text="Mức xử lý (px)"/><ComboBox x:Name="EffectPicker" SelectedIndex="3" SelectionChanged="Effect_Changed" ToolTip="Bán kính làm mờ hoặc kích thước ô pixel; giá trị lớn che mạnh hơn"><ComboBoxItem Content="4 · Nhẹ" Tag="4"/><ComboBoxItem Content="8" Tag="8"/><ComboBoxItem Content="12" Tag="12"/><ComboBoxItem Content="24 · Vừa" Tag="24"/><ComboBoxItem Content="40" Tag="40"/><ComboBoxItem Content="64 · Mạnh" Tag="64"/></ComboBox><TextBlock Text="Che kín để ẩn hoàn toàn. Chia sẻ ảnh đã xuất, ảnh gốc vẫn được giữ riêng." TextWrapping="Wrap" FontSize="11" Foreground="#738092" Margin="3,4"/></StackPanel>
      <TextBlock Text="Màu sắc" Margin="0,14,0,5"/>
      <WrapPanel x:Name="ColorPalette"><Button Background="#008B92" Tag="#008B92" Width="29" Height="29" Padding="0" Click="Color_Click" ToolTip="Xanh teal"/><Button Background="#2E5FA8" Tag="#2E5FA8" Width="29" Height="29" Padding="0" Click="Color_Click" ToolTip="Xanh dương"/><Button Background="#EA5362" Tag="#EA5362" Width="29" Height="29" Padding="0" Click="Color_Click" ToolTip="Đỏ"/><Button Background="#F3C746" Tag="#F3C746" Width="29" Height="29" Padding="0" Click="Color_Click" ToolTip="Vàng"/><Button Background="#26364B" Tag="#26364B" Width="29" Height="29" Padding="0" Click="Color_Click" ToolTip="Đen dịu"/><Button Background="#FFFFFF" Tag="#FFFFFF" Width="29" Height="29" Padding="0" Click="Color_Click" ToolTip="Trắng"/></WrapPanel>
      <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Độ dày"/><ComboBox x:Name="StrokePicker" SelectedIndex="2" SelectionChanged="Style_Changed"><ComboBoxItem Content="1 px" Tag="1"/><ComboBoxItem Content="2 px" Tag="2"/><ComboBoxItem Content="4 px" Tag="4"/><ComboBoxItem Content="6 px" Tag="6"/><ComboBoxItem Content="10 px" Tag="10"/><ComboBoxItem Content="16 px" Tag="16"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Cỡ chữ / số"/><ComboBox x:Name="FontPicker" SelectedIndex="2" SelectionChanged="Style_Changed"><ComboBoxItem Content="16 px" Tag="16"/><ComboBoxItem Content="22 px" Tag="22"/><ComboBoxItem Content="28 px" Tag="28"/><ComboBoxItem Content="36 px" Tag="36"/><ComboBoxItem Content="48 px" Tag="48"/><ComboBoxItem Content="64 px" Tag="64"/><ComboBoxItem Content="96 px" Tag="96"/></ComboBox></StackPanel></Grid>
      <StackPanel x:Name="TextProperties" Visibility="Collapsed"><TextBlock Text="Nội dung chữ"/><TextBox x:Name="AnnotationText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="200" VerticalScrollBarVisibility="Auto" TextChanged="AnnotationText_Changed" LostKeyboardFocus="PropertyText_LostFocus" PreviewKeyDown="PropertyText_KeyDown"/><TextBlock Text="Ctrl+Enter để hoàn tất" FontSize="10" Foreground="#8491A0"/></StackPanel>
      <StackPanel x:Name="StepProperties" Visibility="Collapsed"><TextBlock Text="Số thứ tự"/><TextBox x:Name="StepNumber" ToolTip="1 đến 9999" LostKeyboardFocus="StepNumber_Commit" PreviewKeyDown="StepNumber_KeyDown"/></StackPanel>
      <Expander Header="Căn chỉnh đối tượng" IsExpanded="True" Margin="0,10"><StackPanel>
       <TextBlock Text="1 đối tượng: căn theo ảnh/crop. Nhiều đối tượng: căn theo nhóm." TextWrapping="Wrap" FontSize="11" Foreground="#738092" Margin="3,4"/>
       <UniformGrid x:Name="AlignmentPanel" Columns="3" IsEnabled="False"><Button Content="Trái" Tag="Left" Click="Align_Click" Padding="6,7"/><Button Content="Giữa ↔" Tag="CenterX" Click="Align_Click" Padding="6,7"/><Button Content="Phải" Tag="Right" Click="Align_Click" Padding="6,7"/><Button Content="Trên" Tag="Top" Click="Align_Click" Padding="6,7"/><Button Content="Giữa ↕" Tag="CenterY" Click="Align_Click" Padding="6,7"/><Button Content="Dưới" Tag="Bottom" Click="Align_Click" Padding="6,7"/></UniformGrid>
       <TextBlock x:Name="MultiSelectionHint" Text="Thuộc tính và preset áp dụng cho tất cả đối tượng đã chọn." TextWrapping="Wrap" FontSize="11" Foreground="#008B92" Visibility="Collapsed" Margin="3,4"/>
      </StackPanel></Expander>
      <Button x:Name="DeleteAnnotationButton" Content="Xóa đối tượng · Delete" Click="DeleteAnnotation_Click" IsEnabled="False"/><Button x:Name="RestoreCropButton" Content="Khôi phục khung ảnh gốc" Click="RestoreCrop_Click" IsEnabled="False"/><TextBlock Text="Ảnh gốc được giữ riêng. Chú thích và crop tự lưu để tiếp tục sửa lần sau." TextWrapping="Wrap" FontSize="11" Foreground="#738092" LineHeight="18" Margin="3,8"/><Separator Margin="0,12"/>
     </StackPanel>
     <Expander Header="Thông tin nội dung" IsExpanded="True"><StackPanel><TextBlock x:Name="Metadata" Text="Chọn ảnh hoặc video." TextWrapping="Wrap" Margin="0,8" Foreground="#68798A" LineHeight="21" FontSize="12"/><Button x:Name="RenameButton" Content="Đổi tên nội dung" Click="Rename_Click" IsEnabled="False"/><TextBox x:Name="RenameBox" Visibility="Collapsed" KeyDown="Rename_KeyDown"/><Button x:Name="DeleteButton" Content="Xóa nội dung" Click="Delete_Click" IsEnabled="False"/></StackPanel></Expander>
     <Separator Margin="0,12"/>
     <Expander x:Name="UpdatesExpander" Header="Cập nhật ứng dụng"><StackPanel Margin="0,8,0,0">
      <TextBlock x:Name="CurrentVersionLabel" FontWeight="SemiBold"/>
      <TextBlock x:Name="UpdateInstallLabel" TextWrapping="Wrap" Foreground="#738092" FontSize="11" Margin="0,5"/>
      <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Foreground="#00777F" LineHeight="19" Margin="0,5" AutomationProperties.LiveSetting="Polite"/>
      <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="5" Margin="0,7" Visibility="Collapsed" Foreground="#008B92"/>
      <TextBlock x:Name="UpdatePercent" Foreground="#738092" FontSize="11"/>
      <StackPanel x:Name="UpdateReleasePanel" Visibility="Collapsed"><TextBlock x:Name="UpdateVersionLabel" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6"/>
       <TextBox x:Name="UpdateNotes" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#F3F7F8" Margin="0,3" FontSize="12"/>
      </StackPanel>
      <Button x:Name="CheckUpdatesButton" Content="Kiểm tra cập nhật" Click="CheckUpdates_Click" IsEnabled="False"/>
      <Button x:Name="DownloadUpdateButton" Content="Tải cập nhật" Style="{StaticResource Primary}" Click="DownloadUpdate_Click" Visibility="Collapsed"/>
      <Button x:Name="CancelUpdateButton" Content="Hủy tải" Click="CancelUpdate_Click" Visibility="Collapsed"/>
      <Button x:Name="ApplyUpdateButton" Content="Khởi động lại để cập nhật" Style="{StaticResource Primary}" Click="ApplyUpdate_Click" Visibility="Collapsed" Padding="7,9"/>
      <Button x:Name="DeferUpdateButton" Content="Hoãn cập nhật" Click="DeferUpdate_Click" Visibility="Collapsed"/>
      <TextBlock x:Name="UpdateCaptureHint" Text="Chờ kết thúc chụp/quay và lưu file để cập nhật." TextWrapping="Wrap" Foreground="#9B6B18" FontSize="11" Visibility="Collapsed"/>
      <Button x:Name="OpenReleaseButton" Content="Mở trang tải bản mới" Click="OpenRelease_Click" Visibility="Collapsed"/>
      <TextBlock x:Name="LastUpdateCheckLabel" Foreground="#738092" FontSize="10" TextWrapping="Wrap" Margin="0,7"/>
      <Expander x:Name="UpdateConfiguration" Header="Cấu hình nguồn cập nhật" FontSize="12" Margin="0,6"><StackPanel Margin="0,7,0,0">
       <TextBlock Text="Chỉ dùng nguồn phát hành do Boss tin cậy." TextWrapping="Wrap" FontSize="11" Foreground="#738092"/>
       <ComboBox x:Name="SourceKindPicker" SelectedIndex="0"><ComboBoxItem Content="GitHub Releases (công khai)"/><ComboBoxItem Content="Thư mục HTTPS"/></ComboBox>
       <TextBox x:Name="UpdateSourceBox" TextWrapping="Wrap" MinHeight="56" MaxHeight="110" VerticalScrollBarVisibility="Auto" ToolTip="GitHub: https://github.com/OWNER/REPO; HTTPS: URL thư mục chứa releases.win.json"/>
       <CheckBox x:Name="AutoUpdateCheck" Content="Tự kiểm tra mỗi ngày" IsChecked="True" Margin="3,7"/>
       <Button Content="Lưu cấu hình" Click="SaveUpdateSource_Click"/>
       <TextBlock Text="GitHub: https://github.com/OWNER/REPO. HTTPS: thư mục chứa gói cập nhật. Không nhập token hoặc mật khẩu." TextWrapping="Wrap" Foreground="#738092" FontSize="10" LineHeight="17" Margin="3,5"/>
      </StackPanel></Expander>
     </StackPanel></Expander>
     <Separator Margin="0,12"/><Expander Header="Máy và màn hình"><StackPanel><TextBlock x:Name="DisplaySummary" Margin="0,8" TextWrapping="Wrap" FontSize="11" Foreground="#68798A" LineHeight="20"/><Button Content="Báo cáo máy &amp; màn hình" Click="Diagnostics_Click"/><Button Content="Hướng dẫn kiểm thử" Click="TestGuide_Click"/></StackPanel></Expander>
    </StackPanel></ScrollViewer>
   </DockPanel></Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="3,10,3,0"><TextBlock Text="© 2026 HuyVo" DockPanel.Dock="Right" Foreground="#8A97A5" FontSize="11"/><Button x:Name="UpdateFooterButton" Content="↻ Cập nhật" DockPanel.Dock="Right" Click="UpdateFooter_Click" Padding="10,3" Margin="12,0"/><TextBlock x:Name="StatusText" Text="● Sẵn sàng" Foreground="#66798B" TextTrimming="CharacterEllipsis"/></DockPanel>
 </Grid>
</Window>
