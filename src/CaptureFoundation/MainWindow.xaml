<Window x:Class="CaptureFoundation.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Capture Foundation · V0.1 — Editor" Width="1380" Height="860" MinWidth="1060" MinHeight="660" WindowStartupLocation="CenterScreen">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,10">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Mở file" Click="Import_Click"/><Button x:Name="CopyButton" Content="Copy ảnh" Click="Copy_Click" IsEnabled="False"/><Button x:Name="ExportButton" Content="Xuất file" Click="Export_Click" IsEnabled="False"/></StackPanel>
   <StackPanel Orientation="Horizontal"><Border Background="#DDF2F2" CornerRadius="8" Padding="12,8" Margin="0,0,14,0"><StackPanel><TextBlock Text="CAPTURE FOUNDATION" FontWeight="Bold" Foreground="#00777F"/><TextBlock Text="V0.1 · Một Editor, mọi nội dung" FontSize="11" Foreground="#667788"/></StackPanel></Border><Button x:Name="CaptureButton" Content="▣  Chụp ảnh" Style="{StaticResource Primary}" Click="Capture_Click" ToolTip="Ctrl + Shift + 1"/><Button x:Name="RecordButton" Content="●  Quay màn hình" Click="Record_Click" ToolTip="Ctrl + Shift + 2"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,12" Padding="12,7">
   <Expander Header="Thiết lập chụp &amp; quay" IsExpanded="True"><StackPanel Margin="0,7,0,0">
    <WrapPanel x:Name="ConfigPanel" VerticalAlignment="Center">
     <ComboBox x:Name="SourceMode" Width="135" SelectedIndex="0" SelectionChanged="SourceMode_Changed"><ComboBoxItem Content="Vùng chọn"/><ComboBoxItem Content="Cửa sổ"/><ComboBoxItem Content="Toàn màn hình"/></ComboBox>
     <ComboBox x:Name="DisplayPicker" Width="255" DisplayMemberPath="Label" ToolTip="Màn hình dùng cho chế độ Toàn màn hình"/>
     <ComboBox x:Name="WindowPicker" Width="255" DisplayMemberPath="Title" Visibility="Collapsed" ToolTip="Cửa sổ cần chụp hoặc quay"/>
     <Button Content="↻" ToolTip="Làm mới màn hình và cửa sổ" Click="Refresh_Click" Padding="10,5"/>
     <TextBlock Text="Trễ" VerticalAlignment="Center" Margin="8,0,0,0"/><ComboBox x:Name="DelayPicker" Width="70" SelectedIndex="0"><ComboBoxItem Content="0 giây" Tag="0"/><ComboBoxItem Content="3 giây" Tag="3"/><ComboBoxItem Content="5 giây" Tag="5"/></ComboBox>
     <CheckBox x:Name="CursorToggle" Content="Con trỏ" IsChecked="True"/><CheckBox x:Name="MicToggle" Content="Mic"/><CheckBox x:Name="SystemToggle" Content="Tiếng máy" IsChecked="True"/>
     <ComboBox x:Name="FpsPicker" Width="85" SelectedIndex="1"><ComboBoxItem Content="15 FPS" Tag="15"/><ComboBoxItem Content="30 FPS" Tag="30"/><ComboBoxItem Content="60 FPS" Tag="60"/></ComboBox>
     <CheckBox x:Name="HardwareToggle" Content="Mã hóa GPU" IsChecked="True" ToolTip="Tắt nếu GPU không hỗ trợ mã hóa video. V0.1 dùng H.264, bitrate 8 Mbps, độ phân giải nguồn."/>
    </WrapPanel>
    <TextBlock Text="Ảnh PNG giữ kích thước pixel gốc · Video MP4/H.264 theo kích thước nguồn · Âm thanh theo thiết bị mặc định Windows" FontSize="11" Foreground="#738092" Margin="5,7,0,2"/>
   </StackPanel></Expander>
  </Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="245" MinWidth="190"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Padding="10"><DockPanel>
    <StackPanel DockPanel.Dock="Top"><DockPanel Margin="4,0,4,8"><TextBlock Text="Nội dung" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="CountLabel" HorizontalAlignment="Right" Foreground="#738092"/></DockPanel><TextBox x:Name="SearchBox" ToolTip="Tìm theo tên, ngày hoặc loại nội dung" TextChanged="Search_Changed"/><TextBlock Text="Tìm tên, ảnh hoặc video" FontSize="11" Foreground="#7D8998" Margin="5,0,0,8"/></StackPanel>
    <Button DockPanel.Dock="Bottom" Content="Mở thư mục nội dung" Click="Folder_Click"/>
    <ListBox x:Name="MediaList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Media_Changed" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" CornerRadius="7" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="#E5EAEE" Background="White"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#E7F5F5"/><Setter TargetName="Card" Property="BorderBrush" Value="#008B92"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel><Border Height="95" Background="#EEF2F5" CornerRadius="4"><Grid><TextBlock Text="{Binding Badge}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#647688" FontWeight="SemiBold"/><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Grid></Border><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,7,0,3"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#738092"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="16,12"><TextBlock x:Name="DocumentTitle" Text="Không gian làm việc" FontWeight="SemiBold" FontSize="17"/><TextBlock x:Name="SavedLabel" Foreground="#23946E" HorizontalAlignment="Right"/></DockPanel>
    <Grid Grid.Row="1" Background="#E9EDF1" Margin="8,0"><ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><Grid><Image x:Name="ImagePreview" Stretch="Uniform" Margin="16"/></Grid></ScrollViewer>
     <MediaElement x:Name="VideoPreview" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Visibility="Collapsed" MediaOpened="Video_Opened" MediaEnded="Video_Ended" MediaFailed="Video_Failed"/>
     <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"><TextBlock Text="▣" FontSize="60" Foreground="#008B92" HorizontalAlignment="Center"/><TextBlock Text="Chụp. Quay. Xem lại." FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,10"/><TextBlock Text="Bắt đầu bằng Chụp ảnh hoặc Quay màn hình. Tất cả nội dung được lưu và mở ngay trong Editor này." TextWrapping="Wrap" TextAlignment="Center" Foreground="#68798A" LineHeight="22"/><TextBlock Text="Ctrl + Shift + 1  ·  Chụp ảnh&#10;Ctrl + Shift + 2  ·  Quay màn hình&#10;Ctrl + Shift + 3  ·  Kết thúc quay" TextAlignment="Center" Foreground="#008B92" Margin="0,22,0,0" LineHeight="23"/></StackPanel>
    </Grid>
    <StackPanel Grid.Row="2" Margin="10,8"><StackPanel x:Name="ImageTools" Orientation="Horizontal" Visibility="Collapsed"><Button Content="Vừa khung" Click="Fit_Click"/><Button Content="100% pixel" Click="Actual_Click"/><TextBlock Text="Công cụ chú thích ảnh: lộ trình V1.0–V1.1" VerticalAlignment="Center" Foreground="#7C8797" Margin="10,0" FontSize="11"/></StackPanel>
     <StackPanel x:Name="VideoTools" Visibility="Collapsed"><Slider x:Name="VideoSeek" Minimum="0" PreviewMouseLeftButtonUp="Seek_Released"/><DockPanel><StackPanel Orientation="Horizontal"><Button Content="▶ Phát" Click="Play_Click"/><Button Content="Ⅱ Dừng" Click="Pause_Click"/><TextBlock x:Name="VideoTime" VerticalAlignment="Center" Margin="10,0"/></StackPanel></DockPanel></StackPanel>
    </StackPanel>
   </Grid></Border>
   <Border Grid.Column="4" Style="{StaticResource Panel}" Padding="15"><DockPanel>
    <StackPanel DockPanel.Dock="Bottom"><Separator Margin="0,15"/><TextBlock Text="CAPTURE FOUNDATION · 0.1.0" FontSize="10" Foreground="#8090A0"/><TextBlock Text="Bản kiểm chứng nền tảng" FontSize="11" Foreground="#8090A0" Margin="0,5"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Thông tin nội dung" FontWeight="SemiBold" FontSize="17"/><TextBlock x:Name="Metadata" Text="Chọn ảnh hoặc video để xem thông tin." TextWrapping="Wrap" Margin="0,15" Foreground="#68798A" LineHeight="23"/>
     <Button x:Name="RenameButton" Content="Đổi tên" Click="Rename_Click" IsEnabled="False"/><TextBox x:Name="RenameBox" Visibility="Collapsed" KeyDown="Rename_KeyDown" ToolTip="Nhập tên và Enter để lưu, Esc để hủy"/>
     <Button x:Name="DeleteButton" Content="Xóa nội dung" Click="Delete_Click" IsEnabled="False"/>
     <Separator Margin="0,14"/><TextBlock Text="Kiểm chứng nền tảng" FontWeight="SemiBold"/><TextBlock x:Name="DisplaySummary" Margin="0,10" TextWrapping="Wrap" FontSize="12" Foreground="#68798A" LineHeight="20"/>
     <Button Content="Báo cáo máy &amp; màn hình" Click="Diagnostics_Click"/><Button Content="Hướng dẫn kiểm thử" Click="TestGuide_Click"/>
    </StackPanel></ScrollViewer>
   </DockPanel></Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="3,12,3,0"><TextBlock x:Name="StatusText" Text="● Sẵn sàng" Foreground="#66798B" TextTrimming="CharacterEllipsis"/><TextBlock Text="© 2026 HuyVo" DockPanel.Dock="Right" Foreground="#8A97A5" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
 </Grid>
</Window>
